{
  "name": "volly",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:backend": "cd Backend && bun run /src/index.ts",
    "dev:frontend": "cd Frontend && npm run dev",
    "dev": "concurrently \"bun run dev:backend\" \"bun run dev:frontend\"",
    "i:all": "cd Backend && bun install && cd ../Frontend && npm install",
    "test": "bun test ./Backend ./frontend",
    "test:backend": "cd Backend && bun test",
    "test:frontend": "cd frontend && bun test"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/postgres": "^6.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@fastify/websocket": "^11.2.0",
    "@sinclair/typebox": "^0.34.49",
    "axios": "^1.15.0",
    "bcryptjs": "^3.0.3",
    "bun": "^1.3.13",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.4",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "latest",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "lefthook": "^2.1.6",
    "postcss": "^8.5.10",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.4",
    "vite": "^7.1.11"
  }
}
